# Скопируйте в .env и заполните: cp .env.example .env

# production включает Secure-cookie и делает SESSION_SECRET обязательным.
# Для запуска без Docker на своём компьютере поставьте development.
NODE_ENV=production

HOST=0.0.0.0
PORT=3000

# Адрес сайта без слэша в конце: из него строятся hreflang, sitemap и Open Graph.
PUBLIC_URL=https://yaqingastro.uz

# Где лежат база и фото. В Docker не меняйте: папка уже задана образом
# и подключена как ./data. Без Docker по умолчанию ./data.
# DATA_DIR=./data

# Подпись cookie. Обязателен в production. Получить: openssl rand -hex 32
SESSION_SECRET=

# Первый администратор. Создаётся один раз, пока в базе нет ни одного пользователя.
# Пароль не короче 8 символов. Позже его можно поменять в кабинете.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# true, если сайт стоит за обратным прокси (nginx): тогда виден настоящий IP посетителя.
TRUST_PROXY=true
