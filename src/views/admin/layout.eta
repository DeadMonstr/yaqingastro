<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0F241A">
<meta name="csrf-token" content="<%= it.csrf %>">
<title><%= it.title %> — YAQIN · кабинет</title>
<link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/static/img/icon-192.png">
<link rel="manifest" href="/static/admin.webmanifest">
<link rel="stylesheet" href="/static/css/fonts.css?v=<%= it.assetVersion %>">
<link rel="stylesheet" href="/static/css/admin.css?v=<%= it.assetVersion %>">
</head>
<body class="admin<%= it.user ? ' admin--nav' : '' %>">
<header class="admin-header">
  <div class="admin-header__bar">
    <a class="admin-brand" href="/admin">YAQIN · кабинет</a>
<% if (it.user) { %>
    <nav class="admin-nav" aria-label="Разделы кабинета">
<%
const items = [
  { id: 'menu', href: '/admin', label: 'Меню' },
  { id: 'home', href: '/admin/home', label: 'Главная' },
  { id: 'account', href: '/admin/account', label: 'Аккаунт' }
]
for (const item of items) {
%>
      <a class="admin-nav__link" href="<%= item.href %>"<% if (it.section === item.id) { %> aria-current="page"<% } %>><%= item.label %></a>
<% } %>
    </nav>
<% } %>
    <a class="admin-site-link" href="/ru" target="_blank" rel="noopener">Открыть сайт ↗</a>
  </div>
</header>
<% if (it.saved) { %>
<div class="toast" role="status">Сохранено</div>
<% } %>
<main class="admin-main">
<%~ it.body %>
</main>
<script type="module" src="/static/js/admin.js?v=<%= it.assetVersion %>"></script>
</body>
</html>
