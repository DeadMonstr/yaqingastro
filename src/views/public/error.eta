<% layout('./layout', { mainClass: 'site-main--fill' }) %>
<section class="error-page">
  <div class="error-page__inner">
    <p class="error-page__code"><%= it.code %></p>
    <h1 class="error-page__title"><%= it.heading %></h1>
    <p class="error-page__text"><%= it.text %></p>
    <a class="btn btn--gold" href="<%= it.homeHref %>"><%= it.ui.backHome %></a>
  </div>
</section>
