<!doctype html>
<html lang="<%= it.lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= it.meta.title %></title>
<% if (it.meta.description) { %>
<meta name="description" content="<%= it.meta.description %>">
<% } %>
<% if (it.meta.canonical) { %>
<link rel="canonical" href="<%= it.meta.canonical %>">
<% } %>
<% for (const alt of it.meta.alternates) { %>
<link rel="alternate" hreflang="<%= alt.hreflang %>" href="<%= alt.href %>">
<% } %>
<% if (it.meta.ogImage) { %>
<meta property="og:type" content="website">
<meta property="og:title" content="<%= it.meta.title %>">
<meta property="og:description" content="<%= it.meta.description %>">
<meta property="og:url" content="<%= it.meta.canonical %>">
<meta property="og:image" content="<%= it.meta.ogImage %>">
<% } %>
<link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/static/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/cormorant-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/fonts.css?v=<%= it.assetVersion %>">
<link rel="stylesheet" href="/static/css/site.css?v=<%= it.assetVersion %>">
<script src="/static/js/site.js?v=<%= it.assetVersion %>" defer></script>
</head>
<body>
<%~ include('./partials/header', it) %>
<main class="site-main">
<%~ it.body %>
</main>
<%~ include('./partials/footer', it) %>
</body>
</html>
